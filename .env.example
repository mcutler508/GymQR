# Copy to .env.local and fill in values from Supabase project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set this AFTER first Vercel deploy so the printed QR encodes the production URL.
# Local dev: leave blank — the print page falls back to window.location.origin.
NEXT_PUBLIC_APP_URL=

# Transactional email (member passcode reset). Get a key from https://resend.com.
# If unset, reset links are logged to the server console instead of emailed —
# fine for local dev, not fine for a live pilot.
RESEND_API_KEY=
# The From address on reset emails. Must be a verified sender in your Resend
# account. Leave the default while testing (Resend's onboarding@resend.dev only
# delivers to the account owner).
EMAIL_FROM=RepetoIQ <onboarding@resend.dev>
